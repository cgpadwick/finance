# Copy to .env (repo root) and fill in your keys. .env is gitignored.
# Alpaca PAPER trading keys (required for data ingest):
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: enables in-app AI research reports via OpenRouter (any model slug).
# Without it, the UI falls back to a free "copy research prompt" hand-off.
OPENROUTER_API_KEY=
# RESEARCH_MODEL=deepseek/deepseek-v4-flash   # any OpenRouter slug
# RESEARCH_WEB_SEARCH=true                      # append ":online" for web grounding
